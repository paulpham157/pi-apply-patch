{
	"name": "@paulpham157/apply-patch",
	"version": "0.1.3",
	"description": "Universal apply_patch for every model on Pi, not just gpt-*: GPT, Claude, Gemini, DeepSeek, Kimi, GLM, Qwen, and more. One patch tool across providers with grammar support and JSON fallback.",
	"type": "module",
	"license": "MIT",
	"homepage": "https://github.com/paulpham157/pi-apply-patch#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/paulpham157/pi-apply-patch.git"
	},
	"bugs": {
		"url": "https://github.com/paulpham157/pi-apply-patch/issues"
	},
	"keywords": [
		"pi",
		"pi-mono",
		"pi-coding-agent",
		"pi-extension",
		"coding-agent",
		"apply-patch",
		"codex",
		"typescript",
		"pi-package",
		"model-agnostic"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"scripts": {
		"test": "vitest --run",
		"test:watch": "vitest",
		"typecheck": "tsgo --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"check": "tsgo --noEmit && biome check .",
		"release": "semantic-release"
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": ">=0.85.1",
		"@earendil-works/pi-ai": ">=0.85.1",
		"@earendil-works/pi-coding-agent": ">=0.85.1",
		"@earendil-works/pi-tui": ">=0.85.1",
		"typebox": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.5",
		"@semantic-release/commit-analyzer": "13.0.1",
		"@semantic-release/github": "12.0.9",
		"@semantic-release/npm": "13.1.5",
		"@semantic-release/release-notes-generator": "14.1.1",
		"@types/node": "^26.1.1",
		"@typescript/native-preview": "^7.0.0-dev.20260707.2",
		"conventional-changelog-conventionalcommits": "8.0.0",
		"semantic-release": "25.0.9",
		"typescript": "7.0.2",
		"vitest": "^4.1.10"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"dependencies": {
		"diff": "^9.0.0"
	},
	"files": [
		"src/",
		"docs/",
		"README.md",
		"LICENSE",
		"NOTICE",
		"CHANGELOG.md"
	],
	"publishConfig": {
		"access": "public"
	}
}
