		"@earendil-works/pi-tui": ">=0.85.1",
		"typebox": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.5",
		"@types/node": "^26.1.1",
		"@typescript/native-preview": "^7.0.0-dev.20260707.2",
		"typescript": "7.0.2",
		"vitest": "^4.1.10"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"dependencies": {
		"diff": "^9.0.0"
	}
