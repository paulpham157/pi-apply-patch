{
	"name": "pi-apply-patch",
	"version": "0.1.2",
	"description": "Universal apply_patch extension for Pi with capability-based grammar and JSON tools.",
	"type": "module",
	"license": "MIT",
	"homepage": "https://github.com/code-yeongyu/pi-apply-patch",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/code-yeongyu/pi-apply-patch.git"
	},
	"bugs": {
		"url": "https://github.com/code-yeongyu/pi-apply-patch/issues"
	},
	"keywords": [
		"pi",
		"pi-mono",
		"pi-coding-agent",
		"pi-extension",
		"coding-agent",
		"apply-patch",
		"codex",
		"openai",
		"gpt",
		"typescript"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"scripts": {
		"test": "vitest --run",
		"test:watch": "vitest",
		"typecheck": "tsgo --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"check": "tsgo --noEmit && biome check ."
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": ">=0.85.1",
		"@earendil-works/pi-ai": ">=0.85.1",
